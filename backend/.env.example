NODE_ENV=development
PORT=4000

# Database (set one or both as needed)
DATABASE_URL=
NEON_DATABASE_URL=

# LLM provider placeholders
LLM_API_BASE_URL=
LLM_API_KEY=
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_CODE_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=deepseek-r1-distill-llama-70b

# WebSocket policy
WS_CORS_ORIGIN=*
